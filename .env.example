# Token del bot de Telegram (obligatorio).
TELEGRAM_BOT_TOKEN=

# ID de chat del administrador. Si se define, solo el admin y los usuarios
# autorizados podrán usar el bot (el admin puede autorizar/revocar IDs desde
# el propio bot). Si se deja vacío, el bot queda abierto a cualquiera.
ADMIN_CHAT_ID=

# Tiempo máximo por petición HTTP (formato Go: 30s, 1m...).
HTTP_TIMEOUT=30s

# Directorio donde se guardan productos y usuarios autorizados.
STATE_DIR=config
